rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // Private site: only these two Google accounts may read or write anything.
    function allowed() {
      return signedIn()
        && request.auth.token.email_verified == true
        && myEmail() in ['derhyeden@gmail.com', 'mdekel16@gmail.com'];
    }
    function myFamily() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }

    // Each person's own profile (points at their family)
    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // Email invites: the family that sent it, or the invited person, can see it
    match /invites/{email} {
      allow read: if allowed() && (myEmail() == email || resource.data.familyId == myFamily());
      allow create, update: if allowed() && request.resource.data.familyId == myFamily();
      allow delete: if allowed() && (myEmail() == email || resource.data.familyId == myFamily());
    }

    // A family and everything in it: only allowed people whose profile points at it.
    match /families/{fid} {
      allow read, create, update: if allowed() && myFamily() == fid;
      match /{sub=**} {
        allow read, write: if allowed() && myFamily() == fid;
      }
    }
  }
}
